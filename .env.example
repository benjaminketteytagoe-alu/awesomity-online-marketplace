# ---------------- Postgres ----------------
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace

# ---------------- RabbitMQ ----------------
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=marketplace

# ---------------- JWT ----------------
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-please-rotate-me-now-1234567890
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---------------- App URLs ----------------
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# ---------------- Mail (dev = Mailhog) ----------------
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@marketplace.local

# ---------------- Admin bootstrap ----------------
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=changemepleaseadminpassword
