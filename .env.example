# ============================================================
# Marketplace — environment template
#
# Copy this file to .env and you're ready to run the stack:
#   cp .env.example .env
#   docker compose up -d --build
#
# The two values marked ⚠️ are the ONLY ones you must replace
# before any non-local deployment. Everything else is fine as-is
# for local development.
# ============================================================

# ---------------- Postgres ----------------
# Dev-only defaults. Override in production.
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace

# ---------------- RabbitMQ ----------------
# Dev-only defaults. Override in production.
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=marketplace

# ---------------- JWT ----------------
# ⚠️ REQUIRED before production. Must be >= 64 chars (HS512).
# Generate a fresh one with:
#   openssl rand -base64 64 | tr -d '\n' | tr '+/' '-_'
#
# The value below is a dev placeholder — long enough to boot
# cleanly, but anyone with this file can forge tokens. Rotate
# before you deploy anywhere.
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-please-rotate-me-now-1234567890
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---------------- App URLs ----------------
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# ---------------- Mail (dev = Mailhog) ----------------
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@marketplace.local

# ---------------- Admin bootstrap ----------------
# ⚠️ REQUIRED before production. Password must be >= 12 characters.
# AdminSeeder creates the admin on first boot if it doesn't exist.
# Change it and restart the backend to rotate.
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=change-me-please-admin-password
