# ============================================================
# Marketplace — environment variables
# ============================================================
# Copy to .env before running `docker compose up`.
#     cp .env.example .env
#
# The values below are safe defaults for local development.
# For production deployment, override JWT_SECRET and ADMIN_PASSWORD
# with strong random values.
# ============================================================

# ------------------------------------------------------------
# Postgres
# ------------------------------------------------------------
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=marketplace

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-please-rotate-me-now
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------
# Backend URL from the backend's own perspective.
APP_BASE_URL=http://localhost:8080

# URL of the frontend, used in verification and invite emails.
# When running the Docker frontend, this is localhost:3000.
# When running Vite dev server directly, use localhost:5173.
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Mail (development = Mailhog)
# ------------------------------------------------------------
MAIL_FROM=no-reply@marketplace.local

# ------------------------------------------------------------
# Admin bootstrap account
# ------------------------------------------------------------
# The AdminSeeder creates this user on first startup if the
# email does not already exist. Password must be at least 12
# characters. Change for any non-local deployment.
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=Admin-Marketplace-2026
