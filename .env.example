# Postgres
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace

# RabbitMQ
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=marketplace

# JWT
# Generate a proper secret with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars-long-for-hs512
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# App URLs
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# Mailhog
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@marketplace.local

# ---------------- Admin bootstrap ----------------
# Set these on FIRST boot only. AdminSeeder creates the user if it doesn't exist.
# Rotate the password via the platform's secret store afterwards.
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PASSWORD=Admin$$marketplace1
